<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidPasteAsClassExtensionPackage">
    <Groups>
      <!-- Define a group for your menu item -->
      <Group guid="guidPasteAsClassCommandSet" id="PasteAsClassGroup" priority="0x0600" />
    </Groups>

    <Buttons>
      <!-- Define your button inside that group -->
      <Button guid="guidPasteAsClassCommandSet" id="PasteAsClassCommandId" priority="0x0100" type="Button">
        <Parent guid="guidPasteAsClassCommandSet" id="PasteAsClassGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>TextChangesButton</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <CommandFlag>DontCache</CommandFlag>
        <Strings>
          <ButtonText>Paste as Class</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidPasteAsClassCommandSet" id="PasteAsNamespaceClassCommandId" priority="0x0100" type="Button">
        <Parent guid="guidPasteAsClassCommandSet" id="PasteAsClassGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>TextChangesButton</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <CommandFlag>DontCache</CommandFlag>
        <Strings>
          <ButtonText>Paste as Namespace and Class</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- 1. Right-click on the Solution node -->
    <!-- Paste class does not use the solution node. Option removed
      <CommandPlacement guid="guidPasteAsClassCommandSet" id="MySolutionExplorerGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE"/>
      </CommandPlacement>
    -->

    <!-- 2. Right-click on a Project node -->
    <CommandPlacement guid="guidPasteAsClassCommandSet" id="PasteAsClassGroup" priority="0x0100">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE"/>
    </CommandPlacement>

    <!-- 3. Right-click on a Folder node -->
    <CommandPlacement guid="guidPasteAsClassCommandSet" id="PasteAsClassGroup" priority="0x0100">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_FOLDERNODE"/>
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="guidPasteAsClassExtensionPackage" value="{47781015-81c2-49ef-bb6c-39895f4a5f87}" />
    <GuidSymbol name="guidPasteAsClassCommandSet" value="{968c03c3-e904-4f98-8cac-7262c34a305a}">
      <IDSymbol name="PasteAsClassGroup" value="0x0600" />
      <IDSymbol name="PasteAsClassCommandId" value="0x0100" />
      <IDSymbol name="PasteAsNamespaceClassCommandId" value="0x0101" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
